PORT=5000
# Optional. Without a token, GitHub API rate limits are much lower and
# bulk scans of 200-500 repos may fail. Create a token with no scopes
# (public repos only) and paste it here. Never commit a real .env file.
GITHUB_TOKEN=
# Comma-separated origins allowed to call this API from a browser.
# Use "*" only if you deliberately want any website to call this API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# API rate limit: requests per IP per minute for /api/*
API_RATE_LIMIT_PER_MINUTE=120
